{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "majy-web",
  "main": "src/worker.js",
  "compatibility_date": "2026-07-11",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "MAJY_Academy_DB",
      "database_id": "REPLACE_WITH_YOUR_CLOUDFLARE_D1_DATABASE_ID",
      "migrations_dir": "migrations"
    }
  ],
  "triggers": {
    "crons": ["30 2 * * *"]
  }
}
